<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="formation_diplome_list" model="ir.ui.view">
        <field name="name">formation.diplome.list</field>
        <field name="model">formation.diplome</field>
        <field name="arch" type="xml">
            <list string="Diplômes">
                <field name="name"/>
                <field name="code_rncp"/>
                <field name="niveau_europeen"/>
                <field name="certificateur" optional="show"/>
                <field name="source"/>
                <field name="matiere_count"/>
                <field name="micro_competence_valide_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'valide'" decoration-info="statut == 'brouillon'"/>
            </list>
        </field>
    </record>

    <record id="formation_diplome_form" model="ir.ui.view">
        <field name="name">formation.diplome.form</field>
        <field name="model">formation.diplome</field>
        <field name="arch" type="xml">
            <form string="Diplôme">
                <header>
                    <button name="action_import_rncp" type="object" string="Importer depuis le RNCP"
                            class="btn-primary" icon="fa-download" invisible="not code_rncp"/>
                    <button name="%(action_formation_import_blocs_wizard)d" type="action"
                            string="Saisir les blocs manuellement" context="{'default_diplome_id': id}"/>
                    <button name="action_valider" type="object" string="Valider le diplôme"
                            invisible="statut == 'valide'"
                            groups="formation_diplomante_architect.group_formation_architect_manager"/>
                    <button name="action_brouillon" type="object" string="Remettre en brouillon"
                            invisible="statut == 'brouillon'"
                            groups="formation_diplomante_architect.group_formation_architect_manager"/>
                    <field name="statut" widget="statusbar"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not llm_quota_depasse">
                    Le quota d'appels IA de ce diplôme est atteint
                    (<field name="llm_call_count" class="oe_inline" readonly="1"/> appels).
                    Les générations restent possibles mais augmentent le coût.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_micro_competences" type="object" class="oe_stat_button" icon="fa-list-ul">
                            <field name="micro_competence_count" widget="statinfo" string="Micro-compétences"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. BTS Services informatiques aux organisations"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code_rncp" placeholder="RNCP35185"/>
                            <field name="code_cfd"/>
                            <field name="niveau_europeen"/>
                        </group>
                        <group>
                            <field name="certificateur"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="llm_quota_depasse" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Structure (années et semestres)" name="structure">
                            <field name="annee_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="semestre_ids" widget="many2many_tags"/>
                                </list>
                                <form string="Année">
                                    <group>
                                        <field name="name"/>
                                    </group>
                                    <field name="semestre_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Matières" name="matieres">
                            <field name="matiere_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code_bloc"/>
                                    <field name="semestre_id"/>
                                    <field name="coefficient"/>
                                    <field name="volume_horaire"/>
                                    <field name="micro_competence_count" string="Micro-compétences"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assistant IA" name="ia">
                            <group>
                                <group string="Suivi des appels">
                                    <field name="llm_call_count"/>
                                    <field name="llm_call_quota"/>
                                </group>
                                <group string="Validation">
                                    <field name="micro_competence_count" string="Micro-compétences"/>
                                    <field name="micro_competence_valide_count"/>
                                </group>
                            </group>
                            <separator string="Prompt engineering"/>
                            <p class="text-muted">
                                Laissez vide pour utiliser le prompt par défaut ci-dessous.
                                Le format de réponse JSON est toujours ajouté automatiquement.
                            </p>
                            <field name="prompt_systeme" placeholder="Prompt système personnalisé pour ce diplôme…"/>
                            <label for="prompt_systeme_defaut"/>
                            <field name="prompt_systeme_defaut"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="formation_diplome_search" model="ir.ui.view">
        <field name="name">formation.diplome.search</field>
        <field name="model">formation.diplome</field>
        <field name="arch" type="xml">
            <search string="Diplômes">
                <field name="name"/>
                <field name="code_rncp"/>
                <field name="certificateur"/>
                <filter name="filter_brouillon" string="Brouillons" domain="[('statut', '=', 'brouillon')]"/>
                <filter name="filter_valide" string="Validés" domain="[('statut', '=', 'valide')]"/>
                <separator/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_formation_diplome" model="ir.actions.act_window">
        <field name="name">Diplômes</field>
        <field name="res_model">formation.diplome</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier diplôme</p>
            <p>Saisissez son code RNCP puis importez ses blocs de compétences.</p>
        </field>
    </record>

</odoo>
